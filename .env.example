# Database Connection (PostgreSQL 16)
# Local development with Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vehiclevault?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vehiclevault?schema=public"

# Hosted Supabase Examples:
# DATABASE_URL (Transaction Pooler - Port 6543, for runtime queries):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL (Direct Connection - Port 5432, for Prisma migrations):
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# NextAuth Authentication
NEXTAUTH_SECRET="replace-with-a-random-32-character-secret"
NEXTAUTH_URL="https://your-project.vercel.app"

# Nodemailer / SMTP settings for Email Reminders
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VehicleVault Reminders <reminders@vehiclevault.local>"

# Scheduled Cron Security Secret
CRON_SECRET="replace-with-a-random-32-character-secret"

# Web Push VAPID keys for PWA Push Notifications (generate using npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@vehiclevault.local"
